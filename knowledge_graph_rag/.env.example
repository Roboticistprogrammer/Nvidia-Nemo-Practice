# Copy to .env and adjust. Docker Compose reads this file for the backend container.

# --- Auth -------------------------------------------------------------------
# Users sign in with their own NVIDIA API key (https://build.nvidia.com); each key gets a
# private workspace. Secret used to derive workspace ids - generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it later "moves" every user to a new, empty workspace.
WORKSPACE_SECRET=

# Optional: let users without a key use the server's key. Local dev only - anyone who can
# open the UI would spend your credits.
ALLOW_SERVER_KEY=false
NVIDIA_API_KEY=

# --- Models -----------------------------------------------------------------
# Hosted NVIDIA models offered in the UI (first = default). NVIDIA retires models
# regularly; check https://build.nvidia.com/models if requests start failing with 404/410.
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b
EVAL_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Reward-model scoring on the evaluation page; leave empty to hide it
REWARD_MODEL=

# --- Storage ----------------------------------------------------------------
# Local dev: where workspaces are stored (Docker always uses /data in a named volume)
DATA_DIR=./backend/data
# Local dev: Milvus from docker-compose. For Zilliz Cloud set the URI + token instead.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=50
# Parallel LLM calls while extracting triples; lower it if you hit rate limits
EXTRACTION_WORKERS=4

# --- Frontend ---------------------------------------------------------------
# Local dev only (Docker sets http://backend:8000)
BACKEND_URL=http://localhost:8000
# Docker: where the UI is published. Keep 127.0.0.1 behind the Caddy HTTPS proxy;
# use 0.0.0.0 to expose port 8501 directly (no HTTPS).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8501
# Domain for the Caddy HTTPS proxy (docker compose --profile https up -d)
DOMAIN=

# --- Advanced ---------------------------------------------------------------
# Skip the model's hidden reasoning for triple/entity extraction (~7x faster).
# Set to false if a configured model rejects `chat_template_kwargs`.
DISABLE_REASONING_FOR_EXTRACTION=true
